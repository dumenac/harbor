#!/usr/bin/env python3
"""harbor — the design-system engine of the Harbor i3 rice.

Renders ~/.config/i3/harbor/tokens.toml (plus your overrides in ~/.config/i3/local/tokens.toml)
into i3, the bar, rofi, dunst, kitty, GTK apps (and Firefox, which follows GTK), fastfetch,
the wallpaper and the lock screen, and keeps Day/Night in step with the clock.

  harbor apply [--fade]        render the current appearance; reload everything that shows it
  harbor render                write the generated config files only (no X needed)
  harbor check                 render both appearances and validate them (used by CI)
  harbor set auto|light|dark   choose an appearance (Auto follows the clock)
  harbor toggle                flip Light ⇄ Dark against the clock; flipping back returns to Auto
  harbor status                print preference and effective mode
  harbor brief                 one human line ("Day · dark at 20:00"), used by fastfetch
  harbor watch                 per-session daemon: the 20:00 / 07:00 switch, Focus timer, prewarming
  harbor wallpaper             re-apply only the wallpaper (e.g. after a monitor change)
  harbor focus [on|off|toggle|menu] [minutes]   Do Not Disturb + a quiet wallpaper + countdown
  harbor lock                  lock the screen (i3lock-color: live clock, accent ring)
  harbor center                Control Center (rofi)
  harbor power                 power menu (rofi)
  harbor calendar              this month as a notification (bar: click the clock)
  harbor greet                 login greeting, once per X server
  harbor dnd|nightshift|stats|caffeine [toggle|on|off]

Generated files carry a "generated by harbor" header; edit tokens.toml (colours, type,
shape, motion, focus, sound, apps, terminal) or harbor/look.conf (i3's directives) instead.
"""
import calendar
import datetime as dt
import hashlib
import json
import math
import os
import re
import shutil
import signal
import subprocess as sp
import tempfile
import sys
import threading
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
I3 = HOME / ".config/i3"
SCRIPTS = I3 / "scripts"
TOKENS = I3 / "harbor/tokens.toml"
LOCAL_TOKENS = I3 / "local/tokens.toml"
LOOK = I3 / "harbor/look.conf"
GEN_I3 = I3 / "harbor/generated.conf"
GEN_ROFI = HOME / ".config/rofi/harbor.rasi"
GEN_DUNST = HOME / ".config/dunst/dunstrc.d/90-harbor.conf"
GEN_KITTY = HOME / ".config/kitty/harbor.conf"
GEN_XSETTINGS = HOME / ".config/xsettingsd/xsettingsd.conf"
GEN_GTK3 = HOME / ".config/gtk-3.0/settings.ini"
GEN_GTK4 = HOME / ".config/gtk-4.0/settings.ini"
FASTFETCH_TPL = I3 / "harbor/fastfetch.jsonc"
GEN_FASTFETCH = HOME / ".config/fastfetch/config.jsonc"
CACHE = HOME / ".cache/harbor"
THEME_JSON = CACHE / "theme.json"
PREF = HOME / ".local/state/harbor/appearance"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "harbor"
DISPLAY = os.environ.get("DISPLAY", ":0")
FOCUS = RUN / f"focus{DISPLAY}.json"

# ImageMagick 7 ships `magick`; 6 (Ubuntu 22.04 and older) has `convert` / `identify`.
MAGICK = shutil.which("magick")
IM = [MAGICK] if MAGICK else ["convert"]
IDENTIFY = [MAGICK, "identify"] if MAGICK else ["identify"]

HEADER = "generated by harbor from ~/.config/i3/harbor/tokens.toml — edit that file, not this one"
FADE_FRAMES = 14

# Material Design glyphs (Nerd Font). Used like SF Symbols: one weight, one size, monochrome.
G = {
    "appearance": "\U000F050E", "dnd": "\U000F009B", "bell": "\U000F009C", "coffee": "\U000F0176",
    "nightshift": "\U000F0594", "stats": "\U000F0570", "shot": "\U000F0E51", "keys": "\U000F097B",
    "power": "\U000F0425", "lock": "\U000F033E", "sleep": "\U000F0904", "hibernate": "\U000F04B2",
    "restart": "\U000F0709", "logout": "\U000F0343", "check": "\U000F012C", "sun": "\U000F0599",
    "moon": "\U000F0594", "auto": "\U000F1396", "lighthouse": "\U000F09FF", "lighthouse_on": "\U000F0A00",
    "calendar": "\U000F00ED", "chevron": "\U000F0142", "wallpaper": "\U000F02E9",
    "focus": "\U000F117B", "timer": "\U000F051B", "plus": "\U000F0419", "stop": "\U000F0667",
    "clipboard": "\U000F0A38", "emoji": "\U000F01F5", "calc": "\U000F15A6", "apps": "\U000F003B",
}


# ── small helpers ────────────────────────────────────────────────────────────────────────
def run(*cmd, **kw):
    kw.setdefault("stdout", sp.DEVNULL)
    kw.setdefault("stderr", sp.DEVNULL)
    try:
        return sp.run(cmd, **kw)
    except OSError:
        return None


def out(*cmd):
    try:
        return sp.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, sp.SubprocessError):
        return ""


def detach(*cmd):
    try:
        sp.Popen(cmd, stdin=sp.DEVNULL, stdout=sp.DEVNULL, stderr=sp.DEVNULL, start_new_session=True)
    except OSError:
        pass


def write_if_changed(path: Path, text: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        if path.read_text() == text:
            return False
    except OSError:
        pass
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_text(text)
    os.replace(tmp, path)
    return True


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexc(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in c)


def mix(a, b, t):
    """t = 0 → a, t = 1 → b"""
    A, B = rgb(a), rgb(b)
    return hexc([A[i] + (B[i] - A[i]) * t for i in range(3)])


def with_alpha(h, a):
    return f"{h}{round(a * 255):02x}"


def notify(summary, body="", app="harbor", tag=None, timeout=None, urgency=None):
    cmd = ["notify-send", "-a", app]
    if tag:
        cmd += ["-h", f"string:x-dunst-stack-tag:{tag}"]
    if timeout is not None:
        cmd += ["-t", str(int(timeout * 1000))]
    if urgency:
        cmd += ["-u", urgency]
    run(*cmd, summary, body)


def chime(tok, key):
    path = tok.get("sound", {}).get(key, "")
    if not path or not Path(path).exists():
        return
    vol = tok["sound"].get("volume", 0.4)
    if shutil.which("pw-play"):
        detach("pw-play", "--volume", str(vol), path)
    elif shutil.which("paplay"):
        detach("paplay", f"--volume={round(vol * 65536)}", path)


def font_file(pattern):
    """Path of the font fontconfig picks for a pattern like "Inter:style=SemiBold"."""
    return out("fc-match", "-f", "%{file}", pattern).strip() or pattern


def i3lock_color():
    """i3lock-color under any of its usual names; Arch installs it as plain `i3lock`."""
    for c in (shutil.which("i3lock-color"), HOME / ".local/opt/i3lock-color/bin/i3lock-color",
              HOME / ".local/bin/i3lock-color"):
        if c and os.access(c, os.X_OK):
            return str(c)
    try:
        v = sp.run(["i3lock", "--version"], capture_output=True, text=True, timeout=2)
        if re.search(r"version \S+\.c\.", v.stdout + v.stderr):
            return "i3lock"
    except (OSError, sp.SubprocessError):
        pass
    return None


def display_alive():
    m = re.match(r"^[^:]*:(\d+)", DISPLAY)
    return not m or Path(f"/tmp/.X11-unix/X{m.group(1)}").exists()


def proc_on_display(name):
    for pid in out("pgrep", "-x", name).split():
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if f"DISPLAY={DISPLAY}".encode() in env:
            return True
    return False


def pids_on_display(name):
    pids = []
    for pid in out("pgrep", "-x", name).split():
        try:
            if f"DISPLAY={DISPLAY}".encode() in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
                pids.append(int(pid))
        except OSError:
            continue
    return pids


def composited():
    return proc_on_display("picom")


def restart_tray_apps():
    """blueman's tray icon never re-reads the icon theme, so it would stay dark-on-dark after
    the switch; restart it (this display only) so it picks up the Papirus variant for the bar."""
    applet = pids_on_display("blueman-applet")
    if not applet:
        return
    for pid in applet + pids_on_display("blueman-tray"):
        try:
            os.kill(pid, 15)
        except OSError:
            pass
    time.sleep(0.4)
    detach("blueman-applet")


def signal_bar():
    run("pkill", "-USR1", "-x", "harbor-bar")


def wake_watcher():
    """The watcher sleeps until its next deadline; SIGUSR1 makes it re-read Focus state now."""
    run("pkill", "-USR1", "-x", "harbor-watch")


def set_comm(name):
    try:
        Path("/proc/self/comm").write_text(name)
    except OSError:
        pass


def root_prop(name, value=None):
    if value is None:
        return "= 1" in out("xprop", "-root", name)
    run("xprop", "-root", "-f", name, "32c", "-set", name, str(value))


# ── tokens, palette, appearance ──────────────────────────────────────────────────────────
def merge(base, extra):
    for k, v in extra.items():
        base[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return base


def load():
    with TOKENS.open("rb") as f:
        tok = tomllib.load(f)
    if LOCAL_TOKENS.exists():
        with LOCAL_TOKENS.open("rb") as f:
            merge(tok, tomllib.load(f))
    return tok


def minutes_of(hhmm):
    h, m = hhmm.split(":")
    return int(h) * 60 + int(m)


def clock_mode(tok, now=None):
    now = now or dt.datetime.now()
    m = now.hour * 60 + now.minute
    n, d = minutes_of(tok["schedule"]["night_starts"]), minutes_of(tok["schedule"]["day_starts"])
    night = (m >= n or m < d) if n > d else (n <= m < d)
    return "night" if night else "day"


def pref():
    try:
        p = PREF.read_text().strip()
    except OSError:
        return "auto"
    return p if p in ("auto", "light", "dark") else "auto"


def effective(tok):
    return {"light": "day", "dark": "night"}.get(pref()) or clock_mode(tok)


def applied_file():
    return RUN / f"applied{DISPLAY}"


def applied():
    try:
        return applied_file().read_text().strip()
    except OSError:
        return None


def sky_colour(path: Path):
    """Average colour of the top strip of the wallpaper: what the bar 'sees through'."""
    cache = CACHE / "sky.json"
    key = f"{path}:{path.stat().st_mtime_ns}"
    try:
        known = json.loads(cache.read_text())
    except (OSError, ValueError):
        known = {}
    if key not in known:
        hx = out(*IM, str(path), "-gravity", "north", "-crop", "100%x4%+0+0", "+repage",
                 "-resize", "1x1!", "-format", "%[hex:p{0,0}]", "info:").strip()
        known[key] = "#" + (hx[:6].lower() if re.fullmatch(r"[0-9A-Fa-f]{6,8}", hx) else "808080")
        write_if_changed(cache, json.dumps(known, indent=1))
    return known[key]


def palette(tok, mode):
    c = tok[mode]
    p = {k: v for k, v in c.items() if isinstance(v, str) and v.startswith("#")}
    wall = Path(os.path.expanduser(c["wallpaper"]))
    p["wallpaper"] = str(wall)
    p["sky"] = sky_colour(wall) if wall.exists() else c["base"]
    p["bar"] = mix(c["base"], p["sky"], c["vibrancy"])
    p["bar_pill"] = mix(p["bar"], c["text"], 0.12)       # focused workspace
    p["bar_pill_dim"] = mix(p["bar"], c["text"], 0.06)   # visible on the other monitor
    p["select"] = mix(c["canvas"], c["accent"], 0.16)
    p["alpha_panel"] = c["alpha_panel"]
    return p


# ── renderers ────────────────────────────────────────────────────────────────────────────
def render_i3(tok, p, mode):
    """Fill look.conf's {{token}} placeholders; unknown names are left visible so i3 -C flags them."""
    values = {**{k: f"{v:g}" if isinstance(v, float) else str(v)
                 for k, v in {**tok["type"], **tok["shape"]}.items()}, **p, "mode": mode}
    body = re.sub(r"\{\{(\w+)\}\}", lambda m: str(values.get(m.group(1), m.group(0))), LOOK.read_text())
    return f"# {HEADER}\n# appearance: {mode}\n\n{body}"


def render_rofi(tok, p, mode):
    a = p["alpha_panel"]
    t = tok["type"]
    v = {
        "h-mode": f'"{mode}"',
        "h-panel": with_alpha(p["canvas"], a),
        "h-panel-solid": p["canvas"],
        "h-field": with_alpha(p["text"], 0.06),
        "h-hairline": with_alpha(p["text"], 0.10),
        "h-text": p["text"], "h-muted": p["text_muted"], "h-faint": p["text_faint"],
        "h-accent": p["accent"], "h-on-accent": p["on_accent"],
        "h-select": with_alpha(p["accent"], 0.16), "h-danger": p["danger"],
        "h-font": f'"{t["ui"]}, {t["icons"]} {t["size_menu"]:g}px"',
        "h-font-big": f'"{t["ui"]}, {t["icons"]} Light {t["size_menu_big"]:g}px"',
        "h-font-mono": f'"{t["mono"]} {t["size_menu"] - 2:g}px"',
        "h-radius": f'{tok["shape"]["radius_panel"]}px',
        "h-radius-small": f'{tok["shape"]["radius_small"]}px',
    }
    body = "\n".join(f"    {k}: {val};" for k, val in v.items())
    return f"/* {HEADER} */\n* {{\n{body}\n}}\n"


def notify_offset(tok):
    """Where notification cards sit: on the window grid — level with the tiled windows' right
    edge and top edge. `notify_offset = "auto"` measures the live bar and gaps through i3 (they
    scale with DPI); a [x, y] pair in tokens.toml pins it."""
    want = tok["shape"].get("notify_offset", "auto")
    if isinstance(want, list) and len(want) == 2:
        return int(want[0]), int(want[1])
    try:
        tree = json.loads(out("i3-msg", "-t", "get_tree") or "{}")
    except ValueError:
        tree = {}
    bar, gaps = 0, []

    def walk(node, output=None):
        nonlocal bar
        if node.get("type") == "output":
            output = node
        if node.get("type") == "dockarea" and node.get("name") == "topdock":
            bar = max(bar, node["rect"]["height"])
        if node.get("window") and output and node.get("type") == "con":
            g = node["rect"]["x"] - output["rect"]["x"]
            if 0 < g < 200:
                gaps.append(g)
        for child in node.get("nodes", []):   # tiled only: floating_nodes are left out on purpose
            walk(child, output)

    walk(tree)
    gap = min(gaps) if gaps else tok["shape"]["gap_inner"] + tok["shape"]["gap_outer"]
    return gap, (bar or 24) + gap


def render_dunst(tok, p, mode):
    bg = with_alpha(p["canvas"], p["alpha_panel"])
    t, s = tok["type"], tok["shape"]
    ox, oy = notify_offset(tok)
    return f"""# {HEADER}
[global]
    offset = ({ox}, {oy})
    font = {t['ui']}, {t['icons']} {t['size_notify']:g}px
    corner_radius = {s['radius_notify']}
    frame_color = "{p['hairline']}"
    separator_color = "{p['hairline']}"

[urgency_low]
    background = "{bg}"
    foreground = "{p['text_muted']}"
    frame_color = "{p['hairline']}"
    highlight = "{p['accent']}"

[urgency_normal]
    background = "{bg}"
    foreground = "{p['text']}"
    frame_color = "{p['hairline']}"
    highlight = "{p['accent']}"

[urgency_critical]
    background = "{bg}"
    foreground = "{p['text']}"
    frame_color = "{p['danger']}"
    highlight = "{p['danger']}"
"""


def render_kitty(tok, mode):
    t = tok["terminal"]
    m = t[mode]
    lines = [f"# {HEADER}", f"# appearance: {mode}",
             f"background            {m['background']}",
             f"foreground            {m['foreground']}",
             f"cursor                {m['cursor']}",
             "cursor_text_color     background",
             f"selection_background  {m['selection']}",
             "selection_foreground  none",
             f"url_color             {t['color12']}",
             f"active_border_color   {m['cursor']}",
             f"inactive_border_color {mix(m['background'], m['foreground'], 0.15)}",
             f"tab_bar_background    {m['background']}",
             f"active_tab_background {m['tab_active']}",
             f"active_tab_foreground {m['foreground']}",
             f"inactive_tab_background {m['background']}",
             f"inactive_tab_foreground {mix(m['background'], m['foreground'], 0.5)}"]
    lines += [f"color{i:<17}{t[f'color{i}']}" for i in range(16)]
    return "\n".join(lines) + "\n"


def render_xsettings(tok, mode):
    a = tok["apps"]
    theme = a["day_theme"] if mode == "day" else a["night_theme"]
    icons = a["day_icons"] if mode == "day" else a["night_icons"]
    return (f"# {HEADER}\n"
            f'Net/ThemeName "{theme}"\n'
            f'Net/IconThemeName "{icons}"\n'
            f'Gtk/CursorThemeName "{a["cursor"]}"\n'
            f'Gtk/CursorThemeSize {a["cursor_size"]}\n'
            f'Gtk/FontName "{a["font"]}"\n'
            "Net/EnableEventSounds 0\n"
            "Net/EnableInputFeedbackSounds 0\n")


def render_gtk_ini(tok, mode):
    a = tok["apps"]
    return (f"# {HEADER}\n[Settings]\n"
            f"gtk-theme-name={a['day_theme'] if mode == 'day' else a['night_theme']}\n"
            f"gtk-application-prefer-dark-theme={0 if mode == 'day' else 1}\n"
            f"gtk-icon-theme-name={a['day_icons'] if mode == 'day' else a['night_icons']}\n"
            f"gtk-font-name={a['font']}\n"
            f"gtk-cursor-theme-name={a['cursor']}\n"
            f"gtk-cursor-theme-size={a['cursor_size']}\n")


def sgr(h):
    """#rrggbb → the ANSI truecolor parameters fastfetch's {#…} wants: 38;2;r;g;b"""
    return "38;2;%d;%d;%d" % rgb(h)


def fastfetch_logo(tok, mode):
    """The lighthouse, cut from this appearance's wallpaper, with rounded corners."""
    wall = Path(palette(tok, mode)["wallpaper"])
    if not wall.exists():
        return None
    f = tok.get("fastfetch", {})
    x, y, w, h = f.get("logo_crop", [0.281, 0.194, 0.302, 0.593])
    dst = CACHE / "fastfetch" / f"lighthouse-{mode}-{digest(wall, wall.stat().st_mtime_ns, x, y, w, h, f.get('logo_radius'))}.png"
    if dst.exists():
        return dst
    for old in (CACHE / "fastfetch").glob(f"lighthouse-{mode}-*.png"):
        old.unlink(missing_ok=True)
    W, H = (int(v) for v in out(*IDENTIFY, "-format", "%w %h", str(wall)).split())
    ow = 480
    oh = round(ow * (h * H) / (w * W))
    r = round(ow * f.get("logo_radius", 0.09))
    return magick_out([*IM, str(wall), "-crop", f"{round(w * W)}x{round(h * H)}+{round(x * W)}+{round(y * H)}",
                       "+repage", "-resize", f"{ow}x{oh}!",
                       "(", "+clone", "-alpha", "extract", "-fill", "black", "-colorize", "100", "-fill", "white",
                       "-draw", f"roundrectangle 0,0 {ow - 1},{oh - 1} {r},{r}", ")",
                       "-alpha", "off", "-compose", "CopyOpacity", "-composite"], dst)


def render_fastfetch(tok, mode, logo):
    """fastfetch prints in kitty, which stays dark: colours come from the terminal palette."""
    t, m = tok["terminal"], tok["terminal"][mode]
    bg, fg = m["background"], m["foreground"]
    values = {
        "accent": sgr(m["cursor"]), "fg": sgr(fg), "muted": sgr(mix(bg, fg, 0.6)),
        "faint": sgr(mix(bg, fg, 0.45)), "hairline": sgr(mix(bg, fg, 0.18)),
        "track": sgr(mix(bg, fg, 0.16)),
        "success": sgr(t["color2"]), "warning": sgr(t["color3"]), "danger": sgr(t["color1"]),
        "logo": str(logo or ""), "harbor": str(SCRIPTS / "harbor"),
        "harbor_glyph": G["lighthouse_on"] if mode == "night" else G["lighthouse"],
    }
    body = re.sub(r"\{\{(\w+)\}\}", lambda x: values.get(x.group(1), x.group(0)), FASTFETCH_TPL.read_text())
    if not logo:
        body = body.replace('"type": "auto"', '"type": "none"', 1)
    return f"// {HEADER}\n// appearance: {mode}\n{body}"


def brief(tok):
    """One line for fastfetch and friends: what Harbor is doing right now."""
    mode, s = effective(tok), tok["schedule"]
    if pref() == "auto":
        text = (f"Day · dark at {s['night_starts']}" if mode == "day"
                else f"Night · light on until {s['day_starts']}")
    else:
        text = f"{'Light' if mode == 'day' else 'Dark'} (pinned) · auto with $mod+Ctrl+w"
    f = focus_state()
    if f:
        left = focus_left(f)
        text += f" · Focus{f' {left} min' if left is not None else ''}"
    return text


def apply_gsettings(tok, mode):
    """libadwaita/GTK4 apps and the XDG portal (Firefox's prefers-color-scheme) read these."""
    a = tok["apps"]
    schema = "org.gnome.desktop.interface"
    want = {
        "color-scheme": "prefer-dark" if mode == "night" else "default",
        "gtk-theme": a["day_theme"] if mode == "day" else a["night_theme"],
        "icon-theme": a["day_icons"] if mode == "day" else a["night_icons"],
        "cursor-theme": a["cursor"],
    }
    for key, val in want.items():
        if out("gsettings", "get", schema, key).strip().strip("'") != val:
            run("gsettings", "set", schema, key, val)


# ── wallpaper ────────────────────────────────────────────────────────────────────────────
def layout():
    cur = re.search(r"current (\d+) x (\d+)", out("xrandr", "--current"))
    mons = [tuple(map(int, m.groups())) for m in
            re.finditer(r"(\d+)/\d+x(\d+)/\d+\+(\d+)\+(\d+)", out("xrandr", "--listactivemonitors"))]
    if not cur or not mons:
        return None
    return (int(cur.group(1)), int(cur.group(2))), mons


def digest(*parts):
    return hashlib.sha1("|".join(map(str, parts)).encode()).hexdigest()[:12]


def magick_out(cmd, dst: Path):
    """Run an ImageMagick command that writes to a temp file, then move it into place."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(f".{dst.stem}.{os.getpid()}{dst.suffix}")
    r = run(*cmd, str(tmp))
    if r is None or r.returncode or not tmp.exists():
        tmp.unlink(missing_ok=True)
        return None
    os.replace(tmp, dst)
    return dst


def cover(wall, w, h, blur=None):
    """ImageMagick ops: the wallpaper 'cover'-fitted to w×h (optionally blurred), as a sub-image."""
    ops = ["(", str(wall), "-resize", f"{w}x{h}^", "-gravity", "center", "-extent", f"{w}x{h}"]
    if blur:
        scale, sigma = blur
        ops += ["-scale", f"{scale}%", "-blur", f"0x{sigma}", "-resize", f"{w}x{h}!"]
    return ops + [")"]


def composite(wall: Path, lay):
    """One image the size of the whole X screen with the wallpaper 'cover'-fitted per monitor."""
    (W, H), mons = lay
    dst = CACHE / "wall" / f"{digest(wall, wall.stat().st_mtime_ns, W, H, mons)}.jpg"
    if dst.exists():
        return dst
    cmd = [*IM, "-size", f"{W}x{H}", "xc:black"]
    for w, h, x, y in mons:
        cmd += cover(wall, w, h) + ["-gravity", "northwest", "-geometry", f"+{x}+{y}", "-composite"]
    return magick_out(cmd + ["-quality", "95"], dst)


def focus_composite(tok, mode, wall: Path, lay):
    """The quiet wallpaper: blurred, with a small caption top right."""
    (W, H), mons = lay
    f, p = tok["focus"], palette(tok, mode)
    dst = CACHE / "focus" / (digest(wall, wall.stat().st_mtime_ns, W, H, mons, mode,
                                    f["title"], f["subtitle"], "v1") + ".jpg")
    if dst.exists():
        return dst
    cmd = [*IM, "-size", f"{W}x{H}", "xc:black"]
    for w, h, x, y in mons:
        cmd += cover(wall, w, h, blur=(16, 3)) + ["-gravity", "northwest", "-geometry", f"+{x}+{y}", "-composite"]
    cmd += ["-fill", "white" if mode == "day" else "black", "-colorize", "6%", "-gravity", "northeast"]
    for w, h, x, y in mons:
        rx, ty = W - (x + w) + round(w * 0.035), y + round(h * 0.066)
        cmd += ["-font", font_file("Inter:style=SemiBold"), "-pointsize", str(round(h * 0.0145)),
                "-fill", p["text"], "-annotate", f"+{rx}+{ty}", f["title"],
                "-font", font_file("Inter:style=Regular"), "-pointsize", str(round(h * 0.0095)),
                "-fill", p["text_muted"], "-annotate", f"+{rx}+{ty + round(h * 0.024)}", f["subtitle"]]
    return magick_out(cmd + ["-quality", "95"], dst)


def fade_frames(a: Path, b: Path):
    """Crossfade frames a → b (excluding the endpoints), cached per pair; smoothstep eased."""
    lo, hi = sorted([a, b])
    d = CACHE / "fade" / digest(lo.name, hi.name, FADE_FRAMES)
    frames = [d / f"{i:02d}.jpg" for i in range(1, FADE_FRAMES)]
    todo = [(i, f) for i, f in enumerate(frames, 1) if not f.exists()]
    if todo:
        def make(job):
            i, f = job
            t = i / FADE_FRAMES
            pct = round(100 * t * t * (3 - 2 * t))
            magick_out([*IM, str(lo), str(hi), "-compose", "blend", "-define", f"compose:args={pct}",
                        "-composite", "-quality", "86"], f)

        with ThreadPoolExecutor(max_workers=max(2, (os.cpu_count() or 4) // 2)) as ex:
            list(ex.map(make, todo))
    frames = [f for f in frames if f.exists()]
    return frames if a == lo else frames[::-1]


def set_root(img: Path):
    run("feh", "--no-fehbg", "--no-xinerama", "--bg-center", str(img))


def root_file():
    return RUN / f"root{DISPLAY}"


def current_root():
    try:
        p = Path(root_file().read_text().strip())
    except OSError:
        return None
    return p if p.exists() else None


def target_image(tok, mode, lay):
    wall = Path(palette(tok, mode)["wallpaper"])
    if not wall.exists():
        return None
    if focus_state():
        return focus_composite(tok, mode, wall, lay) or composite(wall, lay)
    return composite(wall, lay)


def wallpaper(tok, mode, fade=False, midway=None):
    """Show the right wallpaper for `mode` (and Focus), crossfading from whatever is on screen.
    `midway` runs halfway through the fade — that's when the chrome (i3, bar, dunst) switches."""
    lay = layout()
    final = target_image(tok, mode, lay) if lay else None
    if final is None:
        if midway:
            midway()
        wall = Path(palette(tok, mode)["wallpaper"])
        if wall.exists():
            run("feh", "--no-fehbg", "--bg-fill", str(wall))
        else:
            run("xsetroot", "-solid", palette(tok, mode)["canvas"])
        return
    start = current_root() if fade else None
    frames = fade_frames(start, final) if start and start != final else []
    if frames:
        helper = threading.Thread(target=midway or (lambda: None), daemon=True)
        step = tok["motion"]["wallpaper_fade"] / (len(frames) + 1)
        for i, f in enumerate(frames):
            t0 = time.monotonic()
            set_root(f)
            if i == len(frames) // 2:
                helper.start()
            time.sleep(max(0.0, step - (time.monotonic() - t0)))
        set_root(final)
        helper.join(timeout=10)
    else:
        if midway:
            midway()
        set_root(final)
    RUN.mkdir(parents=True, exist_ok=True)
    root_file().write_text(str(final))
    fehbg = HOME / ".fehbg"
    write_if_changed(fehbg, f"#!/bin/sh\n# written by harbor\nfeh --no-fehbg --no-xinerama --bg-center '{final}'\n")
    fehbg.chmod(0o755)


# ── apply ────────────────────────────────────────────────────────────────────────────────
def reload_targets(tok, mode, what):
    if "i3" in what and out("xprop", "-root", "I3_SOCKET_PATH").count('"'):
        run("i3-msg", "-q", "reload")
    if "dunst" in what:
        run("dunstctl", "reload")
    if "kitty" in what:
        run("pkill", "-USR1", "-x", "kitty")      # kitty re-reads kitty.conf (and harbor.conf)
    if "apps" in what:
        run("pkill", "-HUP", "-x", "xsettingsd")  # GTK apps and Firefox switch theme live
        apply_gsettings(tok, mode)
        restart_tray_apps()
    signal_bar()


def render(tok=None, mode=None):
    """Write every generated file for `mode`; return the set of things that need reloading."""
    tok = tok or load()
    mode = mode or effective(tok)
    p = palette(tok, mode)
    what = set()
    if write_if_changed(GEN_I3, render_i3(tok, p, mode)):
        what.add("i3")
    if write_if_changed(GEN_DUNST, render_dunst(tok, p, mode)):
        what.add("dunst")
    write_if_changed(GEN_ROFI, render_rofi(tok, p, mode))  # read at every launch
    if FASTFETCH_TPL.exists():                              # read at every run
        write_if_changed(GEN_FASTFETCH, render_fastfetch(tok, mode, fastfetch_logo(tok, mode)))
    if write_if_changed(GEN_KITTY, render_kitty(tok, mode)):
        what.add("kitty")
    apps = [write_if_changed(GEN_XSETTINGS, render_xsettings(tok, mode)),
            write_if_changed(GEN_GTK3, render_gtk_ini(tok, mode)),
            write_if_changed(GEN_GTK4, render_gtk_ini(tok, mode))]
    if any(apps):
        what.add("apps")
    theme = {"mode": mode, "pref": pref(), "palette": p, "type": tok["type"], "glyphs": G,
             "schedule": tok["schedule"]}
    write_if_changed(THEME_JSON, json.dumps(theme, indent=1, ensure_ascii=False))
    return what


def apply(fade=False):
    tok = load()
    mode = effective(tok)
    what = render(tok, mode)
    prev = applied()
    if prev != mode:
        what |= {"i3", "dunst", "kitty", "apps"}
    wallpaper(tok, mode, fade=fade and prev is not None,
              midway=lambda: reload_targets(tok, mode, what))
    RUN.mkdir(parents=True, exist_ok=True)
    applied_file().write_text(mode)
    return prev, mode


def set_pref(value):
    PREF.parent.mkdir(parents=True, exist_ok=True)
    PREF.write_text(value + "\n")
    apply(fade=True)


def describe(tok=None):
    tok = tok or load()
    mode = effective(tok)
    label = {"day": "Light", "night": "Dark"}[mode]
    return ("Auto · " + label) if pref() == "auto" else label


# ── Focus ────────────────────────────────────────────────────────────────────────────────
def focus_raw():
    try:
        return json.loads(FOCUS.read_text())
    except (OSError, ValueError):
        return None


def focus_state():
    """Active Focus session or None (an expired one counts as over; the watcher tidies up)."""
    s = focus_raw()
    if s and s.get("until") and time.time() >= s["until"]:
        return None
    return s


def focus_left(s):
    return None if not s.get("until") else max(0, math.ceil((s["until"] - time.time()) / 60))


def focus_on(minutes=None):
    tok = load()
    minutes = tok["focus"]["minutes"] if minutes is None else minutes
    prev = focus_raw()
    now = time.time()
    s = {"started": prev["started"] if prev else now,
         "until": now + minutes * 60 if minutes else None,
         "dnd_before": prev["dnd_before"] if prev else is_on("dnd")}
    RUN.mkdir(parents=True, exist_ok=True)
    FOCUS.write_text(json.dumps(s))
    run("dunstctl", "set-paused", "true")
    signal_bar()
    wake_watcher()
    if not prev:
        wallpaper(tok, applied() or effective(tok), fade=True)


def focus_extend(minutes):
    s = focus_raw()
    if not s:
        return focus_on(minutes)
    s["until"] = max(s.get("until") or time.time(), time.time()) + minutes * 60
    FOCUS.write_text(json.dumps(s))
    signal_bar()
    wake_watcher()


def focus_off(done=False):
    s = focus_raw()
    if not s:
        return
    FOCUS.unlink(missing_ok=True)
    tok = load()
    if not s.get("dnd_before"):
        run("dunstctl", "set-paused", "false")
    signal_bar()
    wallpaper(tok, applied() or effective(tok), fade=True)
    mins = max(1, round((time.time() - s["started"]) / 60))
    if done:
        chime(tok, "focus_end")
        notify(f"{G['focus']}  Focus complete",
               f"{mins} minute{'s' if mins != 1 else ''} of quiet. Notifications are back on.",
               tag="harbor-focus", timeout=8)


def focus_menu():
    tok = load()
    faint = theme_json()["palette"]["text_faint"]
    s = focus_state()
    if s:
        left = focus_left(s)
        mesg = f"<b>Focus</b>   <span foreground='{faint}'>{f'{left} min left' if left is not None else 'until you turn it off'}</span>"
        opts = [("off", G["stop"], "End Focus"), ("plus", G["plus"], "15 more minutes")]
        i = rofi([row(g, label) for _, g, label in opts], mesg=mesg, width=400)
        if i == 0:
            focus_off()
        elif i == 1:
            focus_extend(15)
        return
    choices = tok["focus"]["choices"]
    opts = [(m, G["timer"], f"{m} minutes") for m in choices] + [(0, G["focus"], "Until I turn it off")]
    default = choices.index(tok["focus"]["minutes"]) if tok["focus"]["minutes"] in choices else 0
    mesg = f"<b>Focus</b>   <span foreground='{faint}'>Do Not Disturb, a quiet wallpaper, a chime at the end</span>"
    i = rofi([row(g, label) for _, g, label in opts], mesg=mesg, selected=default, width=520)
    if i is not None:
        focus_on(opts[i][0] or None)


# ── watch: the 20:00 / 07:00 switch, the Focus timer, prewarming ─────────────────────────
def first_name():
    try:
        import pwd
        gecos = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
    except (KeyError, ImportError):
        gecos = ""
    return (gecos.split()[0] if gecos else os.environ.get("USER", "there")).capitalize()


def part_of_day(now=None):
    h = (now or dt.datetime.now()).hour
    return "morning" if 5 <= h < 12 else "afternoon" if 12 <= h < 18 else "evening"


def prewarm():
    """Build composites, crossfades and the lock image now, so switches are instant later."""
    try:
        tok, lay = load(), layout()
        if not lay:
            return
        mode = applied() or effective(tok)
        walls = {m: Path(palette(tok, m)["wallpaper"]) for m in ("day", "night")}
        base = {m: composite(w, lay) for m, w in walls.items() if w.exists()}
        if base.get("day") and base.get("night"):
            fade_frames(base["day"], base["night"])
        if base.get(mode):
            quiet = focus_composite(tok, mode, walls[mode], lay)
            if quiet:
                fade_frames(base[mode], quiet)
        lock_background(tok, mode, lay)
    except Exception as e:  # noqa: BLE001 — a cold cache only costs a slower first switch
        print(f"harbor prewarm: {e}", file=sys.stderr)


def watch():
    set_comm("harbor-watch")
    RUN.mkdir(parents=True, exist_ok=True)
    wake = threading.Event()
    signal.signal(signal.SIGUSR1, lambda *_: wake.set())
    threading.Timer(10, prewarm).start()
    while display_alive():
        nap = 20.0
        try:
            tok = load()
            mode = effective(tok)
            if applied() not in (None, mode):
                apply(fade=True)
                threading.Thread(target=prewarm, daemon=True).start()
                if pref() == "auto":
                    s = tok["schedule"]
                    chime(tok, "transition")
                    if mode == "night":
                        notify(f"{G['lighthouse_on']}  Good evening",
                               f"The harbor light is on. Dark until {s['day_starts']}.", tag="harbor-mode")
                    else:
                        notify(f"{G['sun']}  Good morning, {first_name()}",
                               f"Light until {s['night_starts']}.", tag="harbor-mode")
            f = focus_raw()
            if f and f.get("until"):
                remaining = f["until"] - time.time()
                if remaining <= 0:
                    focus_off(done=True)
                else:
                    nap = min(nap, remaining + 0.2)
        except Exception as e:  # noqa: BLE001 — keep the daemon alive; log and retry
            print(f"harbor watch: {e}", file=sys.stderr)
        wake.wait(nap)
        wake.clear()


def greet():
    if root_prop("HARBOR_GREETED"):
        return
    root_prop("HARBOR_GREETED", 1)
    tok = load()
    s, mode = tok["schedule"], effective(tok)
    body = (f"Night falls over the harbor at {s['night_starts']}." if mode == "day"
            else f"The harbor light is on until {s['day_starts']}.")
    glyph = G["lighthouse"] if mode == "day" else G["lighthouse_on"]
    notify(f"{glyph}  Good {part_of_day()}, {first_name()}", body, tag="harbor-greet", timeout=6)


# ── lock screen ──────────────────────────────────────────────────────────────────────────
# Per monitor: blurred Edgartown, a live clock in the upper third (i3lock-color), and below it a
# ring with the lighthouse inside — like the avatar above a password field. The ring lights up in
# the accent as you type, turns red on a wrong password.
LOCK_RING_Y = 0.72   # indicator centre, as a fraction of monitor height
LOCK_RADIUS = 38


def lock_background(tok, mode, lay):
    wall = Path(palette(tok, mode)["wallpaper"])
    if not lay or not wall.exists():
        return None
    (W, H), mons = lay
    p = palette(tok, mode)
    dst = CACHE / "lock" / (digest(wall, wall.stat().st_mtime_ns, W, H, mons, mode, LOCK_RING_Y, "v3") + ".png")
    if dst.exists():
        return dst
    for old in (CACHE / "lock").glob("*.png"):
        old.unlink(missing_ok=True)
    cmd = [*IM, "-size", f"{W}x{H}", "xc:black"]
    for w, h, x, y in mons:
        cmd += cover(wall, w, h, blur=(12.5, 5)) + ["-gravity", "northwest", "-geometry", f"+{x}+{y}", "-composite"]
    cmd += ["-fill", "black", "-colorize", "26%" if mode == "day" else "8%", "-gravity", "center",
            "-font", font_file("JetBrainsMono Nerd Font:style=Regular"), "-pointsize", str(round(LOCK_RADIUS * 0.95)),
            "-fill", p["accent"] if mode == "night" else "#ffffff"]
    glyph = G["lighthouse_on"] if mode == "night" else G["lighthouse"]
    for w, h, x, y in mons:
        dx, dy = round(x + w / 2 - W / 2), round(y + h * LOCK_RING_Y - H / 2)
        cmd += ["-annotate", f"{dx:+d}{dy:+d}", glyph]
    return magick_out(cmd + ["-define", "png:compression-level=1"], dst)


def lock_args(tok, mode, img):
    p = palette(tok, mode)
    acc, bad = p["accent"].lstrip("#"), p["danger"].lstrip("#")
    ui, display = tok["type"]["ui"], tok["type"]["display"]
    y = LOCK_RING_Y
    return [i3lock_color(), "-n", "-e", "-i", str(img), "-c", p["canvas"].lstrip("#"),
            "--indicator", "--clock", "--force-clock",
            "--time-str=%H:%M", "--date-str=%A, %-d %B",
            f"--time-font={display} Light", f"--date-font={ui}", f"--greeter-font={ui}",
            f"--verif-font={ui}", f"--wrong-font={ui}", f"--layout-font={ui}",
            "--time-size=112", "--date-size=22", "--greeter-size=15", "--modif-size=13",
            "--time-color=ffffffee", "--date-color=ffffffcc", "--greeter-color=ffffffb0",
            "--modif-color=ffffffcc", "--verif-color=ffffffcc", "--wrong-color=ffffffcc",
            "--time-pos=x+w/2:y+h*0.30", "--date-pos=tx:ty+50",
            f"--ind-pos=x+w/2:y+h*{y}", f"--radius={LOCK_RADIUS}", "--ring-width=3",
            "--inside-color=ffffff12", "--ring-color=ffffff55",
            "--line-color=00000000", "--separator-color=00000000",
            f"--insidever-color={acc}33", f"--ringver-color={acc}ff",
            f"--insidewrong-color={bad}33", f"--ringwrong-color={bad}ff",
            f"--keyhl-color={acc}ff", "--bshl-color=ffffffaa",
            "--verif-text=", "--wrong-text=", "--noinput-text=", "--lock-text=",
            "--lockfailed-text=Couldn't lock", "--greeter-text=Enter password",
            f"--greeter-pos=ix:iy+{LOCK_RADIUS + 38}",
            "--pass-media-keys", "--pass-volume-keys"]


def lock(test=False):
    tok, img, mode = None, None, None
    try:
        tok = load()
        mode = applied() or effective(tok)
        img = lock_background(tok, mode, layout())
    except Exception as e:  # noqa: BLE001 — never fail to lock
        print(f"harbor lock: {e}", file=sys.stderr)
    locker = i3lock_color()
    if tok and img and locker:
        args = lock_args(tok, mode, img)
        if test:  # for screenshots: any key unlocks
            args.append("--no-verify")
        os.execvp(locker, args)
    colour = "14181d"
    if img:
        os.execvp("i3lock", ["i3lock", "-n", "-e", "-f", "-c", colour, "-i", str(img)])
    os.execvp("i3lock", ["i3lock", "-n", "-e", "-f", "-c", colour])


# ── menus (rofi) ─────────────────────────────────────────────────────────────────────────
def rofi(rows, prompt="", mesg=None, selected=0, width=440, theme_extra=""):
    """dmenu-style list; returns the chosen index or None."""
    theme = (f"window {{ width: {width}px; }} listview {{ lines: {len(rows)}; }} "
             "mainbox { children: [ message, listview ]; } " + theme_extra)
    if not composited():
        theme += " window { background-color: @h-panel-solid; }"
    cmd = ["rofi", "-dmenu", "-i", "-markup-rows", "-format", "i", "-no-custom", "-p", prompt,
           "-selected-row", str(selected), "-theme-str", theme]
    if mesg:
        cmd += ["-mesg", mesg]
    try:
        r = sp.run(cmd, input="\n".join(rows), capture_output=True, text=True)
    except OSError:
        return None
    s = r.stdout.strip()
    return int(s) if r.returncode == 0 and s.lstrip("-").isdigit() and int(s) >= 0 else None


def theme_json():
    try:
        return json.loads(THEME_JSON.read_text())
    except (OSError, ValueError):
        return {"palette": {"text_faint": "#8a8f96", "accent": "#2e6da4"}}


def row(glyph, label, state=None, faint="#888888"):
    # fixed-advance Nerd Font so labels line up; a step larger, like SF Symbols beside text
    s = f"<span font_family='JetBrainsMono Nerd Font' size='large'>{glyph}</span>   {label}"
    if state:
        s += f"   <span foreground='{faint}'>{state}</span>"
    return s


def is_on(kind):
    if kind == "dnd":
        return out("dunstctl", "is-paused").strip() == "true"
    if kind == "caffeine":
        return (Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "caffeine.on").exists()
    if kind == "focus":
        return focus_state() is not None
    return (RUN / f"{kind}{DISPLAY if kind == 'nightshift' else ''}").exists()


def toggle(kind, want=None):
    on = is_on(kind)
    want = (not on) if want is None else want
    if kind == "dnd":
        run("dunstctl", "set-paused", "true" if want else "false")
    elif kind == "caffeine":
        run(str(SCRIPTS / "caffeine.sh"), "on" if want else "off")
    elif kind == "nightshift":
        if not shutil.which("gammastep"):
            notify(f"{G['nightshift']}  Night Shift", "Install gammastep to warm the screen at night.")
            return
        flag = RUN / f"nightshift{DISPLAY}"
        RUN.mkdir(parents=True, exist_ok=True)
        if want:
            run("gammastep", "-P", "-O", "4200")
            flag.touch()
        else:
            run("gammastep", "-x")
            flag.unlink(missing_ok=True)
    elif kind == "stats":
        flag = RUN / "stats"
        RUN.mkdir(parents=True, exist_ok=True)
        flag.touch() if want else flag.unlink(missing_ok=True)
    elif kind == "focus":
        focus_on() if want else focus_off()
    signal_bar()


def appearance_menu():
    th = theme_json()
    faint = th["palette"]["text_faint"]
    cur = pref()
    tok = load()
    clock = {"day": "Light now", "night": "Dark now"}[clock_mode(tok)]
    s = tok["schedule"]
    opts = [("auto", G["auto"], "Auto", f"Dark {s['night_starts']}–{s['day_starts']} · {clock}"),
            ("light", G["sun"], "Light", None),
            ("dark", G["moon"], "Dark", None)]
    rows = [row(g, (f"<b>{label}</b>" if key == cur else label),
                (G["check"] + ("   " + st if st else "")) if key == cur else st, faint)
            for key, g, label, st in opts]
    i = rofi(rows, mesg="<b>Appearance</b>", selected=[o[0] for o in opts].index(cur), width=460)
    if i is not None and opts[i][0] != cur:
        set_pref(opts[i][0])


def center(selected=0):
    th = theme_json()
    faint = th["palette"]["text_faint"]
    onoff = lambda b: "On" if b else "Off"  # noqa: E731
    f = focus_state()
    focus_label = "Off" if not f else (f"{focus_left(f)} min left" if f.get("until") else "On")
    items = [
        ("appearance", G["appearance"], "Appearance", describe()),
        ("focus", G["focus"], "Focus", focus_label),
        ("dnd", G["dnd"], "Do Not Disturb", onoff(is_on("dnd"))),
        ("caffeine", G["coffee"], "Keep Awake", onoff(is_on("caffeine"))),
        ("nightshift", G["nightshift"], "Night Shift", onoff(is_on("nightshift"))),
        ("stats", G["stats"], "System Stats in Bar", onoff(is_on("stats"))),
        ("calc", G["calc"], "Calculator", None),
        ("clipboard", G["clipboard"], "Clipboard History", None),
        ("emoji", G["emoji"], "Emoji", None),
        ("shot", G["shot"], "Screenshot", None),
        ("keys", G["keys"], "Keyboard Shortcuts", None),
        ("power", G["power"], "Power", None),
    ]
    now = dt.datetime.now()
    mesg = f"<b>Control Center</b>   <span foreground='{faint}'>{now.strftime('%A %-d %B')}</span>"
    i = rofi([row(g, label, st, faint) for _, g, label, st in items], mesg=mesg, selected=selected)
    if i is None:
        return
    key = items[i][0]
    if key in ("dnd", "caffeine", "nightshift", "stats"):
        toggle(key)
        time.sleep(0.05)
        return center(selected=i)  # stays open, like a real control centre
    if key == "appearance":
        appearance_menu()
    elif key == "focus":
        focus_menu()
    elif key in ("calc", "clipboard", "emoji"):
        detach(str(SCRIPTS / "launcher"), key)
    elif key == "shot":
        time.sleep(0.25)  # let rofi's fade-out finish before flameshot grabs the screen
        detach(str(SCRIPTS / "screenshot.sh"), "gui")
    elif key == "keys":
        detach(str(SCRIPTS / "keys.py"))
    elif key == "power":
        power()


def confirm(question, action_label):
    rows = [row(G["check"], action_label), row(G["chevron"], "Cancel")]
    return rofi(rows, mesg=f"<b>{question}</b>", selected=1, width=380) == 0


def power():
    host = os.uname().nodename
    items = [
        ("lock", G["lock"], "Lock Screen", None),
        ("sleep", G["sleep"], "Sleep", None),
        ("hibernate", G["hibernate"], "Hibernate", None),
        ("restart", G["restart"], "Restart…", f"Restart {host} now?"),
        ("poweroff", G["power"], "Shut Down…", f"Shut down {host} now?"),
        ("logout", G["logout"], "Log Out…", "Log out of i3? Open windows will close."),
    ]
    i = rofi([row(g, label) for _, g, label, _ in items], mesg="<b>Power</b>", width=360)
    if i is None:
        return
    key, _, label, question = items[i]
    if question and not confirm(question, label.rstrip("…")):
        return
    if key == "lock":
        time.sleep(0.2)
        detach(str(SCRIPTS / "lock.sh"))
    elif key == "sleep":
        run("systemctl", "suspend")
    elif key == "hibernate":
        run("systemctl", "hibernate")
    elif key == "restart":
        run("systemctl", "reboot")
    elif key == "poweroff":
        run("systemctl", "poweroff")
    elif key == "logout":
        run("i3-msg", "exit")


# ── calendar ─────────────────────────────────────────────────────────────────────────────
def calendar_note():
    th = theme_json()
    p = th["palette"]
    mono = th.get("type", {}).get("mono", "JetBrains Mono")
    today = dt.date.today()
    weeks = calendar.Calendar(firstweekday=0).monthdayscalendar(today.year, today.month)
    head = "  ".join(["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"])
    lines = [f"<span foreground='{p['text_faint']}'>{head}</span>"]
    for w in weeks:
        cells = []
        for col, d in enumerate(w):
            if d == 0:
                cells.append("  ")
            elif d == today.day:
                cells.append(f"<span background='{p['accent']}' foreground='{p['on_accent']}'><b>{d:2d}</b></span>")
            elif col >= 5:
                cells.append(f"<span foreground='{p['text_muted']}'>{d:2d}</span>")
            else:
                cells.append(f"{d:2d}")
        lines.append("  ".join(cells))
    week = today.isocalendar()[1]
    body = f"<span font_family='{mono}'>" + "\n".join(lines) + "</span>"
    body += f"\n<span foreground='{p['text_faint']}'>Week {week} · {today.strftime('%B %Y')}</span>"
    notify(f"{G['calendar']}  {today.strftime('%A, %-d %B')}", body, app="calendar", tag="calendar", timeout=12)


# ── check (CI) ───────────────────────────────────────────────────────────────────────────
def strip_jsonc(text):
    """Drop // comments outside strings, so json can parse fastfetch's JSONC."""
    out_, i, in_str = [], 0, False
    while i < len(text):
        c = text[i]
        if in_str:
            out_.append(c)
            if c == "\\":
                out_.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out_.append(c)
        elif text.startswith("//", i):
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out_.append(c)
        i += 1
    return "".join(out_)


def check():
    """Render Day and Night into a temp dir and validate them; non-zero exit on any problem."""
    tok, problems = load(), []
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        for mode in ("day", "night"):
            p = palette(tok, mode)
            files = {"generated.conf": render_i3(tok, p, mode), "harbor.rasi": render_rofi(tok, p, mode),
                     "90-harbor.conf": render_dunst(tok, p, mode), "kitty harbor.conf": render_kitty(tok, mode),
                     "xsettingsd.conf": render_xsettings(tok, mode), "settings.ini": render_gtk_ini(tok, mode)}
            if FASTFETCH_TPL.exists():
                files["fastfetch config.jsonc"] = render_fastfetch(tok, mode, None)
                try:
                    json.loads(strip_jsonc(files["fastfetch config.jsonc"]))
                except ValueError as e:
                    problems.append(f"{mode}: fastfetch config is not valid JSON: {e}")
            for name, text in files.items():
                for line in text.splitlines():
                    if "{{" in line and not line.lstrip().startswith(("#", "//", "/*", "*")):
                        problems.append(f"{mode}: {name}: unfilled token in: {line.strip()}")
            if shutil.which("i3"):
                gen = tmp / f"generated-{mode}.conf"
                gen.write_text(files["generated.conf"])
                cfg = tmp / f"config-{mode}"
                cfg.write_text((I3 / "config").read_text().replace("~/.config/i3/harbor/generated.conf", str(gen)))
                r = sp.run(["i3", "-C", "-c", str(cfg)], capture_output=True, text=True)
                errors = [l for l in (r.stdout + r.stderr).splitlines() if "ERROR" in l]
                if r.returncode or errors:
                    problems.append(f"{mode}: i3 -C: " + (" | ".join(errors[:6]) or f"exit {r.returncode}"))
            print(f"{'✓' if not any(x.startswith(mode) for x in problems) else '✗'} {mode}: "
                  f"{len(files)} files rendered" + (", i3 config valid" if shutil.which("i3") else ""))
    for x in problems:
        print(f"  ✗ {x}")
    return 1 if problems else 0


# ── CLI ──────────────────────────────────────────────────────────────────────────────────
def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    arg = argv[2] if len(argv) > 2 else None
    if cmd == "apply":
        apply(fade="--fade" in argv)
    elif cmd == "render":
        render()
    elif cmd == "check":
        return check()
    elif cmd == "set" and arg in ("auto", "light", "dark"):
        set_pref(arg)
    elif cmd == "toggle":
        # Flip what's on screen. Flipping back to what the clock says returns to Auto, so two
        # presses never silently cancel the 20:00 / 07:00 switch.
        tok = load()
        target = "night" if effective(tok) == "day" else "day"
        set_pref("auto" if target == clock_mode(tok) else {"day": "light", "night": "dark"}[target])
    elif cmd == "status":
        tok = load()
        f = focus_state()
        print(f"preference={pref()} effective={effective(tok)} clock={clock_mode(tok)} applied={applied()}"
              f" focus={'off' if not f else (focus_left(f) if f.get('until') else 'on')}")
    elif cmd == "brief":
        print(brief(load()))
    elif cmd == "watch":
        watch()
    elif cmd == "wallpaper":
        tok = load()
        wallpaper(tok, applied() or effective(tok))
    elif cmd == "focus":
        if arg == "menu":
            focus_menu()
        elif arg == "off":
            focus_off()
        elif arg == "on" or (arg and arg.isdigit()):
            focus_on(int(argv[3]) if arg == "on" and len(argv) > 3 else (int(arg) if arg.isdigit() else None))
        elif focus_state():
            focus_off()
        else:
            focus_on()
    elif cmd == "lock":
        lock(test="--test" in argv)
    elif cmd == "lock-image":  # debugging
        tok = load()
        print(lock_background(tok, applied() or effective(tok), layout()))
    elif cmd == "prewarm":
        prewarm()
    elif cmd == "center":
        center()
    elif cmd == "appearance":
        appearance_menu()
    elif cmd == "power":
        power()
    elif cmd == "calendar":
        calendar_note()
    elif cmd == "greet":
        greet()
    elif cmd in ("dnd", "nightshift", "stats", "caffeine"):
        toggle(cmd, {"on": True, "off": False}.get(arg))
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
